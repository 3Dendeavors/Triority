{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "types": ["jest"]
  },
  "include": [
    "App.tsx",
    "index.js",
    "__tests__/**/*.ts",
    "__tests__/**/*.tsx",
    "scripts/**/*.ts",
    "scripts/**/*.tsx"
  ],
  "exclude": [
    "**/node_modules",
    "**/Pods",
    "_archive/**",
    "_exports/**",
    "_screenshots/**",
    ".claude/**",
    "Triority/**",
    "docs/archive/**",
    "archive/**"
  ]
}
